# medicalcheckup.20fit.id — public subdomain config

# Port the server listens on (Railway/host injects this)
PORT=3000

# The Medical Record page (/medical) analyses + translates MCU documents by
# forwarding the member's Bearer token to my.20fit.id's OWN /api/mcu and
# /api/translate (same my20fit-ai edge function, same prompts). So this app needs
# NO AI key of its own (no OPENROUTER_API_KEY, no AI edge secret) and no
# service-role key to scan — my.20fit.id verifies the token and calls the AI.
# Only MY20FIT_ORIGIN below must point at the live my.20fit.id.
#
# Host that serves the my.20fit.id member app + real API (/api/mcu, /api/translate).
# Login/registration is now BUILT-IN on this subdomain (local /login, /register,
# /reset-password, /auth/callback via Supabase Auth) — accounts are shared with
# my.20fit.id because it's the SAME Supabase project. This origin is used for the
# server-side AI analyze call and ecosystem links, not for auth redirects.
MY20FIT_ORIGIN=https://my.20fit.id

# Public origin of THIS subdomain (used for canonical URLs, sitemap, and return_to).
PUBLIC_ORIGIN=https://medicalscanner.20fit.id

# Supabase project "20FIT ALL DATA" — used by the BROWSER client for auth
# (setSession) and RLS-protected reads/writes of my20fit_mcu_result.
SUPABASE_URL=https://cpvzwqptzcxnwzfzgrmt.supabase.co

# The anon / publishable key is a PUBLIC client key (safe to ship to the browser).
# NEVER put the service_role key here, and NEVER put any AI/Anthropic key in the
# client — AI runs only on my.20fit.id's server, called from THIS app's server,
# never from the browser.
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# ── Server-only — NEVER exposed to the browser ──

# OPTIONAL — upload validation (RULES.md §2: only real MCU/lab documents).
# When set, POST /api/mcu asks a cheap vision model whether an uploaded IMAGE is
# actually a medical check-up / lab result BEFORE running the (expensive) extraction,
# and rejects anything else (selfie, food, receipt, …) with `invalid_photo`. This is
# medicalscanner-only (the shared my20fit-ai edge is never touched) and FAIL-OPEN:
# UNSET → the vision check is skipped and uploads proceed (a keyless empty-result
# backstop still catches non-MCU documents). Extraction itself needs NO AI key — it
# is proxied to my.20fit.id/api/mcu. Use a vision-capable OpenRouter key.
OPENROUTER_API_KEY=
# Model for that validation check. Defaults to google/gemini-2.5-flash (cheap, fast,
# vision — same family the 20FIT ecosystem already uses). Override if needed.
MCU_VALIDATION_MODEL=google/gemini-2.5-flash


# Supabase service_role key. Used server-side only, for two things:
#  1) /api/scan (members-only, spec §0.1): verify the caller's token + append
#     the AI-access audit trail (my20fit_ai_access_log). Without this key,
#     POST /api/scan responds 503.
#  2) Reading PUBLISHED health articles (public.media_articles) for the SSR
#     /articles pages. Without this key, /articles simply shows an empty list.
# Members still save their own MCU result (my20fit_mcu_result) client-side
# under RLS. This key never ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Shared secret for the article publish API (POST /api/articles). External sites
# send it as `Authorization: Bearer <token>` to publish into this subdomain's own
# mcu_articles table. Generate a long random value (e.g. `openssl rand -hex 32`).
# UNSET → the publish endpoint is disabled (responds 503). Rotate by changing it.
ARTICLES_PUBLISH_TOKEN=

# Official escalation target for every health tool: "want more? consult a
# 20FIT doctor" links here (the in-app Book Doctor flow on my.20fit.id).
# Defaults to <MY20FIT_ORIGIN>/book-doctor — override with the exact route.
DOCTOR_BOOKING_URL=https://my.20fit.id/book-doctor

# "Program & Training" section links (Tahap 3+4). REAL 20FIT service lines only
# — no packages/prices are shown. Each defaults to my.20fit.id; set the exact
# booking/info page for each once confirmed.
TRAIN_HOME_URL=https://my.20fit.id     # home workout / app
TRAIN_EMS_URL=https://my.20fit.id      # EMS studio
TRAIN_ARENA_URL=https://my.20fit.id    # HYROX / arena booking
TRAIN_CLINIC_URL=https://my.20fit.id   # physiotherapy / clinic booking
