# medicalcheckup.20fit.id — public subdomain config

# Port the server listens on (Railway/host injects this)
PORT=3000

# Host that serves the my.20fit.id member app + real API (/api/analyze-mcu, /login).
# The subdomain calls this endpoint server-side and redirects login here.
MY20FIT_ORIGIN=https://my.20fit.id

# Public origin of THIS subdomain (used for canonical URLs, sitemap, and return_to).
PUBLIC_ORIGIN=https://medicalcheckup.20fit.id

# Supabase project "20FIT ALL DATA" — used by the BROWSER client for auth
# (setSession) and RLS-protected reads/writes of my20fit_mcu_result.
SUPABASE_URL=https://cpvzwqptzcxnwzfzgrmt.supabase.co

# The anon / publishable key is a PUBLIC client key (safe to ship to the browser).
# NEVER put the service_role key here, and NEVER put any AI/Anthropic key in the
# client — AI runs only on my.20fit.id's server, called from THIS app's server,
# never from the browser.
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# ── Server-only — NEVER exposed to the browser ──

# Supabase service_role key. Used server-side only, for two things:
#  1) /api/scan (members-only, spec §0.1): verify the caller's token + append
#     the AI-access audit trail (my20fit_ai_access_log). Without this key,
#     POST /api/scan responds 503.
#  2) Reading PUBLISHED health articles (public.media_articles) for the SSR
#     /articles pages. Without this key, /articles simply shows an empty list.
# Members still save their own MCU result (my20fit_mcu_result) client-side
# under RLS. This key never ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Official escalation target for every health tool: "want more? consult a
# 20FIT doctor" links here (the in-app Book Doctor flow on my.20fit.id).
# Defaults to <MY20FIT_ORIGIN>/book-doctor — override with the exact route.
DOCTOR_BOOKING_URL=https://my.20fit.id/book-doctor
